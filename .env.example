# ==================== OpenContextEngine 服务模式配置 ====================
# 本文件由 Settings 元数据自动生成，是 .env 的唯一真源；请勿手改，改 settings.py
# 后重新运行 scripts/generate_env_template.py。
# 分级：Tier 1 展开=最小启动必填；Tier 2/3 折叠成注释=按需取消注释覆盖默认值。
# 服务模式须把 API_KEY / ADMIN_API_KEY 换成强随机值，并配置 PostgreSQL / Milvus / Redis。

# ======================== 功能开关总览 (ON / OFF) ========================
# 所有布尔开关集中速览；[LLM] 标记的功能依赖 LLM 客户端（需配 LLM_API_KEY）。
# 详细参数与说明见下方各 tier 段。
#
#   DB_ECHO=false   是否打印 SQL 日志
#   EMBED_ENABLED=true   是否启用嵌入(关闭时只切块不嵌入)
#   RERANK_ENABLED=true   是否启用 API 重排
#   LLM_RERANK_ENABLED=false [LLM]   是否启用 LLM 语义重排
#   RETRIEVAL_QUERY_DECOMPOSITION_ENABLED=true   是否分解多句检索请求
#   RETRIEVAL_QUERY_REWRITE_ENABLED=false [LLM]   是否启用 LLM 查询改写
#   RETRIEVAL_PATH_INDEX_ENABLED=true   是否启用路径索引（文件名查询增强）
#   RETRIEVAL_INTENT_CLASSIFICATION_ENABLED=true [LLM]   是否启用查询意图分类（LLM-based）
#   WORKER_ENABLED=true   是否启用后台 worker
#   LOG_FILE_ENABLED=true   是否启用日志落盘
#   LOG_FORMAT_JSON=false   是否使用 JSON 格式（便于日志采集）
#   MONITORING_ENABLED=true   是否启用监控采集与落库
#   MONITORING_RETRIEVAL_AUDIT_ENABLED=true   是否记录检索各阶段耗时与空回审计
#   MONITORING_STORE_QUERY_TEXT=true   检索审计是否存储 query 原文（默认开便于排查；隐私敏感部署应关闭）
#
# 检索链路：dense + exact + path 召回 → RRF 融合 → source priority
#           → 重排 → 置信度过滤 → 覆盖度选择

# ======================== Tier 1 · 最小启动必填 ========================

# ---- API 与访问控制 ----
# API 认证密钥；个人模式用与客户端约定的固定值，服务模式须改为强随机值
API_KEY=replace-with-a-long-random-value
# Admin 接口密钥；空则回落 API_KEY，一旦配置则 admin 接口只认此 key
# ADMIN_API_KEY=your_admin_api_key_here

# ---- 数据库配置（PostgreSQL / SQLite 元数据存储） ----
# 数据库连接 URL
DB_URL=postgresql+asyncpg://oce:your_password_here@localhost:5432/oce

# ---- Milvus 3.0 配置（向量存储 + 混合检索） ----
# Milvus 端点：HTTP 服务地址，或本地 Milvus Lite 文件路径
MILVUS_ENDPOINT=http://localhost:19530

# ---- 嵌入模型配置 ----
# Embedding API 密钥；model_credentials 无 active kind=embed 行时回落此值
EMBED_API_KEY=your_embedding_api_key_here

# ---- Redis 配置（任务队列） ----
# queue_name 派生三个键：{name} 主队列；{name}:processing 处理中（worker 取走
# 暂存，崩溃后可恢复）；{name}:pending 在飞哨兵集合（入队去重，防幽灵消息堆积）。
# Redis 连接 URL
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0


# ======================== Tier 2 · 自定义（更换模型 / 功能开关） ========================

# ---- API 与访问控制 ----
# 允许访问 API 的浏览器来源，多个来源用逗号分隔；默认放行官方 admin 面板，设为空则关闭 CORS
# CORS_ORIGINS=https://oce-ai.github.io

# ---- 嵌入模型配置 ----
# 是否启用嵌入(关闭时只切块不嵌入)
# EMBED_ENABLED=true
# OpenAI 兼容的 embedding 端点
# EMBED_ENDPOINT=http://127.0.0.1:8994/v1/embeddings
# 嵌入模型
# EMBED_MODEL=f2llm-v2-0.6b
# 向量维度
# EMBED_DIMENSIONS=1024

# ---- 重排模型配置 ----
# 是否启用 API 重排
# RERANK_ENABLED=true
# Rerank 端点
# RERANK_ENDPOINT=http://127.0.0.1:8994/v1/rerank
# 重排模型
# RERANK_MODEL=jina-reranker-v3.5

# ---- 共享 LLM 客户端配置 ----
# 被三个功能共用同一个 OpenAI 兼容 client：LLM 语义重排（rerank_enabled）、
# 查询改写（RetrievalSettings.query_rewrite_enabled）、意图分类
# （RetrievalSettings.intent_classification_enabled）。三者任一开启即初始化。
# 是否启用 LLM 语义重排
# LLM_RERANK_ENABLED=false
# LLM 模型
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM API Key
# LLM_API_KEY=your_llm_api_key_here
# LLM API Base URL
# LLM_BASE_URL=https://api.siliconflow.cn/v1

# ---- 检索配置 ----
# 是否分解多句检索请求
# RETRIEVAL_QUERY_DECOMPOSITION_ENABLED=true
# 是否启用 LLM 查询改写
# RETRIEVAL_QUERY_REWRITE_ENABLED=false
# 是否启用路径索引（文件名查询增强）
# RETRIEVAL_PATH_INDEX_ENABLED=true
# 是否启用查询意图分类（LLM-based）
# RETRIEVAL_INTENT_CLASSIFICATION_ENABLED=true

# ---- Worker 配置（后台嵌入消费者） ----
# 是否启用后台 worker
# WORKER_ENABLED=true

# ---- 日志配置 ----
# 是否启用日志落盘
# LOG_FILE_ENABLED=true

# ---- 监控配置（调用 / token / 资源采集与落库） ----
# 是否启用监控采集与落库
# MONITORING_ENABLED=true


# ======================== Tier 3 · 高级调优（默认折叠，均有代码默认值） ========================

# ---- 数据库配置（PostgreSQL / SQLite 元数据存储） ----
# 连接池大小
# DB_POOL_SIZE=5
# 连接池溢出上限
# DB_MAX_OVERFLOW=5
# 是否打印 SQL 日志
# DB_ECHO=false

# ---- Milvus 3.0 配置（向量存储 + 混合检索） ----
# 认证 token（Zilliz Cloud）
# MILVUS_TOKEN=your_milvus_token_here
# Collection 名称
# MILVUS_COLLECTION_NAME=oce_chunks
# 路径索引 Collection 名称
# MILVUS_PATH_COLLECTION_NAME=oce_paths
# 密集向量维度
# MILVUS_DENSE_DIM=1024
# 密集向量索引类型
# MILVUS_DENSE_INDEX_TYPE=HNSW
# 密集向量距离度量
# MILVUS_DENSE_METRIC_TYPE=COSINE
# HNSW M 参数
# MILVUS_HNSW_M=32
# HNSW efConstruction
# MILVUS_HNSW_EF_CONSTRUCTION=512
# HNSW ef（搜索时）
# MILVUS_HNSW_EF_SEARCH=512

# ---- 嵌入模型配置 ----
# 单请求文本数
# EMBED_MAX_BATCH_SIZE=32
# 单请求 input 数组总字符预算
# EMBED_MAX_BATCH_CHARS=32000
# 单条模型输入字符上限
# EMBED_MAX_INPUT_CHARS=8000
# 长输入分段重叠字符数
# EMBED_INPUT_OVERLAP_CHARS=400
# 最大请求并发
# EMBED_MAX_CONCURRENCY=4
# 请求超时秒数
# EMBED_TIMEOUT_SECONDS=60.0
# 可选 HTTP 代理
# EMBED_PROXY=
# Query-side instruction（添加到 query 前，为空则不添加）
# EMBED_QUERY_INSTRUCTION=

# ---- 重排模型配置 ----
# 空值时复用 embedding key
# RERANK_API_KEY=your_rerank_api_key_here
# 重排返回数
# RERANK_TOP_N=10
# 最低重排分
# RERANK_MIN_SCORE=0.05
# 请求超时秒数
# RERANK_TIMEOUT_SECONDS=60.0

# ---- 共享 LLM 客户端配置 ----
# LLM API HTTP 代理
# LLM_PROXY=
# LLM 重排最大候选数
# LLM_MAX_CANDIDATES=50
# LLM 重排输出数
# LLM_OUTPUT_TOP_K=10
# 每个候选送入 LLM 的代码字符上限
# LLM_SNIPPET_CHARS=1600
# LLM 接口 TPM 上限，>0 时客户端排队，0 不限流（默认；小配额账号显式设成配额的 80%）
# LLM_TPM_LIMIT=0

# ---- 切块配置（L1：建库期参数，改它要 drop collection + reindex，不可热改） ----
# 两条切块路径各有自己的尺寸旋钮，二者口径不同：
# - ``recursive_*`` 驱动 RecursiveChunker（统一 fallback，按字符窗口递归分隔）
# - ``ast_*``       驱动 CastChunker（AST 语义切块，max 是目标窗口而非硬上限）
# 默认值与提配置前 chunker.py 里的硬编码逐字一致，故装配本组不改变任何切块行为。
# RecursiveChunker 目标块大小（字符）
# CHUNK_RECURSIVE_SIZE=6000
# RecursiveChunker 分隔重叠（只影响切点，不产生块间重复）
# CHUNK_RECURSIVE_OVERLAP=200
# CastChunker 语义块目标窗口（字符）
# CHUNK_AST_MAX_SIZE=1500
# CastChunker 块间重叠字符数
# CHUNK_AST_OVERLAP=0

# ---- 检索配置 ----
# 向量召回条数
# RETRIEVAL_DEFAULT_TOP_K=30
# Milvus dense 相似度过滤阈值；默认不预过滤
# RETRIEVAL_VECTOR_THRESHOLD=0.0
# 最终返回条数
# RETRIEVAL_FINAL_SELECT_K=10
# 多查询结果融合平滑常数
# RETRIEVAL_RRF_K=60
# 最终置信度门槛
# RETRIEVAL_CONFIDENCE_FLOOR=0.0
# SQL 精确标识符召回允许的最大 blob scope；0 表示禁用
# RETRIEVAL_EXACT_MAX_SCOPE_BLOBS=2000
# SQL 精确标识符召回超时；超时后回退向量检索
# RETRIEVAL_EXACT_TIMEOUT_SECONDS=2.0
# 原查询和子查询总数上限
# RETRIEVAL_QUERY_MAX_QUERIES=4
# 子查询最少字符数
# RETRIEVAL_QUERY_MIN_FACET_CHARS=8
# 子查询融合权重
# RETRIEVAL_QUERY_FACET_WEIGHT=0.75
# 单查询模式下覆盖 default_top_k
# RETRIEVAL_PER_QUERY_TOP_K=20
# 单文件最多返回片段数
# RETRIEVAL_MAX_CHUNKS_PER_PATH=2
# 返回代码总字符预算（硬限制）
# RETRIEVAL_MAX_CONTEXT_CHARS=32000
# 同文件片段重叠抑制阈值
# RETRIEVAL_OVERLAP_THRESHOLD=0.6
# 查询改写使用的 LLM 模型
# RETRIEVAL_QUERY_REWRITE_MODEL=Qwen/Qwen2.5-7B-Instruct
# 生成改写查询的数量
# RETRIEVAL_QUERY_REWRITE_NUM=3
# 路径索引命中对同文件 chunk 的加权系数
# RETRIEVAL_PATH_BOOST_WEIGHT=0.5

# ---- Redis 配置（任务队列） ----
# 嵌入队列名称
# REDIS_QUEUE_NAME=oce:embed_queue

# ---- Worker 配置（后台嵌入消费者） ----
# 并发消费协程数
# WORKER_CONCURRENCY=2
# 失败重试上限
# WORKER_MAX_RETRIES=3

# ---- 日志配置 ----
# 日志文件路径（None 时自动推断）
# LOG_FILE_PATH=
# 轮转策略：'1 day' 按天 / '100 MB' 按大小
# LOG_ROTATION=100 MB
# 保留时长：'30 days' / '10 files'
# LOG_RETENTION=30 days
# 是否使用 JSON 格式（便于日志采集）
# LOG_FORMAT_JSON=false
# 日志级别（WARNING/INFO/DEBUG）
# LOG_LEVEL=INFO

# ---- 监控配置（调用 / token / 资源采集与落库） ----
# 缓冲区批量写库间隔秒数
# MONITORING_FLUSH_INTERVAL_SECONDS=5.0
# 单类指标缓冲上限，超出立即 flush
# MONITORING_FLUSH_MAX_BUFFER=500
# 资源采样间隔秒数
# MONITORING_RESOURCE_SAMPLE_INTERVAL_SECONDS=60.0
# 监控数据保留天数（GC 清理阈值）
# MONITORING_RETENTION_DAYS=30
# 监控数据清理任务运行间隔秒数
# MONITORING_CLEANUP_INTERVAL_SECONDS=3600.0
# 是否记录检索各阶段耗时与空回审计
# MONITORING_RETRIEVAL_AUDIT_ENABLED=true
# 检索审计是否存储 query 原文（默认开便于排查；隐私敏感部署应关闭）
# MONITORING_STORE_QUERY_TEXT=true
